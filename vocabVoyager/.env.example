# The notebook works locally without any environment variables.
# Optional: existing VocabVoyager Supabase project (public browser credentials).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional SERVER ONLY, never prefix these with REACT_APP_.
# Choose an available text model in Google AI Studio on the free tier.
# Keep billing disabled for a hard no-spend setup. Quotas vary by model/project.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional server-only key for Datamuse word discovery.
DATAMUSE_API_KEY=
